From 24fe350661aa5d7a7d6c0e9edd36d34f62017782 Mon Sep 17 00:00:00 2001
From: Grin Node Toolkit <noreply@grin-node-toolkit.local>
Date: Fri, 25 Sep 2026 17:41:03 -0400
Subject: [PATCH 1/2] chain: init_output_pos_index - search forward instead of
 walking every height

init_output_pos_index() placed each UTXO that is missing an output_pos
index entry by reading every block header from height 1 to the chain
head, and it kept going after the last missing output was placed. On an
archive node that means millions of random header reads from the block
LMDB (far larger than RAM on a small box), all while chain.compact()
holds the txhashset write lock. It can take hours, and block processing
and the node API stall behind the lock the whole time.

Outputs are already processed in ascending MMR position and a header's
output_mmr_size never decreases with height, so each output's height can
be found by searching forward from the previous output's height. A
galloping search (+1, +3, +7, ...) followed by a binary search of the
last gap gives the same height the linear walk would, at O(log distance)
reads per output. The loop also stops once every output is placed.
---
 chain/src/txhashset/txhashset.rs | 76 ++++++++++++++++++++++++++++++--
 1 file changed, 73 insertions(+), 3 deletions(-)

diff --git a/chain/src/txhashset/txhashset.rs b/chain/src/txhashset/txhashset.rs
index 5d88cd2..61ddac4 100644
--- a/chain/src/txhashset/txhashset.rs
+++ b/chain/src/txhashset/txhashset.rs
@@ -699,10 +699,26 @@ impl TxHashSet {
 		let total_outputs = outputs_pos.len();
 		let max_height = batch.head()?.height;
 
+		// Each missing output belongs to the lowest height (>= 1) whose header
+		// output_mmr_size covers its position. outputs_pos is in ascending MMR
+		// position order (leaf set iteration) and output_mmr_size never decreases
+		// with height, so instead of reading every header since genesis we search
+		// forward from one output's height to the next. On an archive node the
+		// linear walk is millions of random header reads from the block db, all
+		// under the txhashset write lock.
 		let mut i = 0;
-		for search_height in 0..max_height {
-			let hash = header_pmmr.get_header_hash_by_height(search_height + 1)?;
-			let h = batch.get_block_header(&hash)?;
+		let mut next_height = 1;
+		while i < total_outputs {
+			let h = match Self::first_header_covering_output_pos(
+				header_pmmr,
+				batch,
+				outputs_pos[i].1,
+				next_height,
+				max_height,
+			)? {
+				Some(h) => h,
+				None => break,
+			};
 			while i < total_outputs {
 				let (commit, pos1) = outputs_pos[i];
 				if pos1 > h.output_mmr_size {
@@ -717,6 +733,7 @@ impl TxHashSet {
 				)?;
 				i += 1;
 			}
+			next_height = h.height + 1;
 		}
 		debug!(
 			"init_output_pos_index: added entries for {} utxos, took {}s",
@@ -725,6 +742,59 @@ impl TxHashSet {
 		);
 		Ok(())
 	}
+
+	/// Lowest-height header in [from_height, max_height] whose output_mmr_size
+	/// is >= pos1, or None if no header in that range covers pos1.
+	/// Gallops forward (from, from+1, from+3, from+7, ...) and then binary
+	/// searches the last gap, so a nearby answer costs a couple of reads and a
+	/// distant one costs O(log distance) instead of one read per height.
+	fn first_header_covering_output_pos(
+		header_pmmr: &PMMRHandle<BlockHeader>,
+		batch: &Batch<'_>,
+		pos1: u64,
+		from_height: u64,
+		max_height: u64,
+	) -> Result<Option<BlockHeader>, Error> {
+		if from_height > max_height {
+			return Ok(None);
+		}
+		let header_at = |height: u64| -> Result<BlockHeader, Error> {
+			let hash = header_pmmr.get_header_hash_by_height(height)?;
+			Ok(batch.get_block_header(&hash)?)
+		};
+
+		// Gallop until a header covers pos1. `below` is the highest height
+		// known NOT to cover it.
+		let mut below: Option<u64> = None;
+		let mut step: u64 = 1;
+		let mut probe = from_height;
+		let (mut hi, mut best) = loop {
+			let h = header_at(probe)?;
+			if h.output_mmr_size >= pos1 {
+				break (probe, h);
+			}
+			if probe >= max_height {
+				return Ok(None);
+			}
+			below = Some(probe);
+			probe = probe.saturating_add(step).min(max_height);
+			step = step.saturating_mul(2);
+		};
+
+		// Binary search (below, hi] for the lowest covering height.
+		let mut lo = below.map_or(from_height, |b| b + 1);
+		while lo < hi {
+			let mid = lo + (hi - lo) / 2;
+			let h = header_at(mid)?;
+			if h.output_mmr_size >= pos1 {
+				hi = mid;
+				best = h;
+			} else {
+				lo = mid + 1;
+			}
+		}
+		Ok(Some(best))
+	}
 }
 
