<?php

	// Included files
	require_once __DIR__ . "/backend/common.php";
	require_once __DIR__ . "/backend/language.php";
	require_once __DIR__ . "/backend/resources.php";
	
	
	// Main function
	
	// Set content type header
	header("Content-Type: application/manifest+json; charset=" . mb_internal_encoding());

?>{
	<?php /* ACCIO PATCH — the two strings below are deliberately left as
	         upstream wrote them. They are translation KEYS, and brandText() in
	         backend/language.php rewrites every key and value on the way out,
	         so these render as "Accio" and "A Grin wallet." Editing them here
	         would break the lookup and lose the six translations. */ ?>
	"name": "<?= escapeString(getTranslation('MWC Wallet')); ?>",
	"description": "<?= escapeString(getTranslation('A MimbleWimble Coin wallet.')); ?>",
	"background_color": "<?= escapeString(BACKGROUND_COLOR); ?>",
	"theme_color": "<?= escapeString(THEME_COLOR); ?>",
	"icons": [<?php

			// ACCIO PATCH — the SVG mark.
			//
			// Upstream's loop here emits only the FIVE-part APP_ICONS entries
			// and hardcodes "type": "image/png". Our APP_ICONS holds a single
			// one-part SVG entry (see backend/resources.php), which that loop
			// skips — leaving "icons": [], and a manifest with no icons is a
			// PWA that will not offer to install. So the entry is emitted
			// directly, with the right type and "sizes": "any".
			//
			// This also drops upstream's desktop-vs-mobile icon split, which
			// keyed off HTTP_USER_AGENT and could never work in a prerendered
			// build anyway (script052_implementation.md, S1, "Known, accepted
			// degradations of prerendering").
			echo PHP_EOL . "\t\t{" . PHP_EOL;
			echo "\t\t\t\"src\": \"" . escapeString(getResource("./images/app_icons/app_icon.svg")) . "\"," . PHP_EOL;
			echo "\t\t\t\"sizes\": \"any\"," . PHP_EOL;
			echo "\t\t\t\"type\": \"image/svg+xml\"," . PHP_EOL;
			echo "\t\t\t\"purpose\": \"any\"" . PHP_EOL;
			echo "\t\t}";
		?>

	],
	"display": "standalone",
	"display_override": [
		"window-controls-overlay"
	],
	"categories": [
		"finance"
	],
	"prefer_related_applications": false,
	"lang": "<?= escapeString(getLanguage()); ?>",
	"dir": "<?= escapeString(getConstant("Direction")); ?>",
	"orientation": "any",
	"start_url": "./",
	"id": "./",
	"scope": "./",
	"serviceworker": {
		"src": "<?= escapeString(getResource("./scripts/service_worker.js")); ?>",
		"scope": "./"
	},
	<?php /* ACCIO PATCH — Grin only. Upstream registered twelve handlers:
	         web+mwc*, web+grin*, web+epic*. The eight non-Grin ones would ask
	         the operating system to hand Accio links for chains this build
	         cannot open — Consensus.getWalletType() is hardcoded to Grin, so
	         an "Override Wallet Type=MimbleWimble Coin" URL now lands in a
	         Grin wallet. Registering them was a promise we no longer keep. */ ?>
	"protocol_handlers": [
		{
			"protocol": "web+grinhttp",
			"url": "/index.html?<?= urlencode("Override Wallet Type"); ?>=<?= urlencode("Grin"); ?>&<?= urlencode("Override Network Type"); ?>=<?= urlencode("Mainnet"); ?>&<?= urlencode("Request"); ?>=<?= urlencode("Start Transaction"); ?>&<?= urlencode("Recipient Address"); ?>=%s"
		},
		{
			"protocol": "web+grinhttps",
			"url": "/index.html?<?= urlencode("Override Wallet Type"); ?>=<?= urlencode("Grin"); ?>&<?= urlencode("Override Network Type"); ?>=<?= urlencode("Mainnet"); ?>&<?= urlencode("Request"); ?>=<?= urlencode("Start Transaction"); ?>&<?= urlencode("Recipient Address"); ?>=%s"
		},
		{
			"protocol": "web+grintestnethttp",
			"url": "/index.html?<?= urlencode("Override Wallet Type"); ?>=<?= urlencode("Grin"); ?>&<?= urlencode("Override Network Type"); ?>=<?= urlencode("Testnet"); ?>&<?= urlencode("Request"); ?>=<?= urlencode("Start Transaction"); ?>&<?= urlencode("Recipient Address"); ?>=%s"
		},
		{
			"protocol": "web+grintestnethttps",
			"url": "/index.html?<?= urlencode("Override Wallet Type"); ?>=<?= urlencode("Grin"); ?>&<?= urlencode("Override Network Type"); ?>=<?= urlencode("Testnet"); ?>&<?= urlencode("Request"); ?>=<?= urlencode("Start Transaction"); ?>&<?= urlencode("Recipient Address"); ?>=%s"
		}
	]
}
